rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Server-side token store: NEVER accessible from client ──────────────
    match /artifacts/{appId}/_server/{document=**} {
      allow read, write: if false;
    }

    // ── Per-user config (watchlist, Tastytrade connection state) ───────────
    // Only the owner can read/write their own config
    match /artifacts/{appId}/users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // ── Shared market-data cache (options-monitor) ─────────────────────────
    // Any authenticated user can read shared cache; only server writes (via
    // Cloud Functions / Admin SDK) should write — client write is allowed
    // here because we have no server-side write path yet, but data is
    // non-sensitive public market data.
    match /artifacts/{appId}/options-monitor/{document=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // ── Put Skew / 25-delta risk reversal history ──────────────────────────
    match /artifacts/{appId}/skew/{document=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // ── Deny everything else by default ───────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
